{
  "version": 2,
  "builds": [
    {
      "src": "chanda-js/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/chanda-js/index.html"
    },
    {
      "src": "/chanda-js/(.*)",
      "dest": "/chanda-js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/chanda-js/$1"
    }
  ]
}
